@{
    ViewData["Title"] = "Доступ запрещён";
}

<div class="row justify-content-center pt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-danger">
            <div class="card-body p-5">
                <i class="bi bi-shield-slash-fill text-danger" style="font-size: 4rem;"></i>
                <h2 class="mt-3 text-danger fw-bold">Доступ запрещён (403 Forbidden)</h2>
                <p class="text-muted fs-5 mt-3">
                    У вашей учётной записи недостаточно прав для просмотра данного ресурса. Панель управления и административные действия доступны исключительно преподавателям.
                </p>
                <div class="mt-4 d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-house me-1"></i>На главную
                    </a>
                    <a asp-controller="Student" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-person-workspace me-1"></i>Мой кабинет студента
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
