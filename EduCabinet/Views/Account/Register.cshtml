@model EduCabinet.Models.RegisterViewModel
@{
    ViewData["Title"] = "Регистрация нового пользователя";
}

<div class="row justify-content-center pt-3">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-success text-white text-center py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Регистрация пользователя</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="Например: Иванов Иван Иванович" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold"></label>
                        <input asp-for="Username" class="form-control" placeholder="Придумайте логин" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" class="form-control" placeholder="Минимум 6 символов" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Повторите пароль" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-semibold"></label>
                        <select asp-for="Role" class="form-select" id="roleSelect" onchange="toggleGroupSelect()">
                            <option value="@EduCabinet.Models.UserRoles.Student">Студент</option>
                            <option value="@EduCabinet.Models.UserRoles.Teacher">Преподаватель</option>
                        </select>
                    </div>

                    <div class="mb-3" id="groupContainer">
                        <label asp-for="GroupId" class="form-label fw-semibold"></label>
                        <select asp-for="GroupId" class="form-select" asp-items="ViewBag.Groups">
                            <option value="">-- Выберите учебную группу --</option>
                        </select>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-success btn-lg fw-bold">Зарегистрироваться</button>
                    </div>

                    <div class="text-center">
                        <span class="text-muted">Уже есть учётная запись?</span>
                        <a asp-action="Login" class="text-decoration-none fw-semibold">Войти</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleGroupSelect() {
            var role = document.getElementById('roleSelect').value;
            var container = document.getElementById('groupContainer');
            if (role === 'Teacher') {
                container.style.display = 'none';
            } else {
                container.style.display = 'block';
            }
        }
    </script>
}
