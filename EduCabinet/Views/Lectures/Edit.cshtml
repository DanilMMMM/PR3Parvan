@model EduCabinet.Models.Lecture
@{
    ViewData["Title"] = "Редактирование лекции";
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Редактировать лекцию</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="TopicId" />
                    <input type="hidden" asp-for="FilePath" />
                    <input type="hidden" asp-for="OriginalFileName" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-9 mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">Название лекции</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="OrderIndex" class="form-label fw-semibold">Порядковый номер</label>
                            <input asp-for="OrderIndex" type="number" class="form-control" min="1" />
                            <span asp-validation-for="OrderIndex" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Краткое описание (аннотация)</label>
                        <textarea asp-for="Description" rows="2" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Content" class="form-label fw-semibold">Теоретический материал (HTML / текст)</label>
                        <textarea asp-for="Content" rows="10" class="form-control font-monospace"></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold"><i class="bi bi-paperclip me-1"></i>Заменить файл материала (DOCX, PDF)</label>
                            <input type="file" name="materialFile" class="form-control" accept=".docx,.pdf,.doc" />
                            @if (!string.IsNullOrEmpty(Model.OriginalFileName))
                            {
                                <div class="small text-muted mt-1">Текущий файл: <strong>@Model.OriginalFileName</strong></div>
                            }
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="MinPassingScore" class="form-label fw-semibold">Проходной балл теста для разблокировки (%)</label>
                            <input asp-for="MinPassingScore" type="number" class="form-control" min="1" max="100" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Отмена</a>
                        <button type="submit" class="btn btn-warning fw-bold px-4">Сохранить изменения</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
