@model EduCabinet.Models.AcademicJournalViewModel
@{
    ViewData["Title"] = "Электронный академический журнал";
}

<style>
    @@media print {
        header, footer, .navbar, .btn-print-hide, .filter-card, .breadcrumb {
            display: none !important;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
        }
        body {
            background-color: #fff !important;
            font-size: 11pt;
            color: #000 !important;
        }
        .container {
            max-width: 100% !important;
            width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .table {
            border-collapse: collapse !important;
            width: 100% !important;
        }
        .table th, .table td {
            border: 1px solid #333 !important;
            padding: 4px 6px !important;
            color: #000 !important;
        }
        .print-only-header {
            display: block !important;
            margin-bottom: 20px;
        }
        .badge {
            border: 1px solid #333 !important;
            color: #000 !important;
            background: transparent !important;
        }
        .page-break {
            page-break-before: always;
        }
    }
    .print-only-header {
        display: none;
    }
</style>

<!-- Printable Official Header -->
<div class="print-only-header text-center">
    <h3 class="fw-bold mb-1">ЭЛЕКТРОННЫЙ ЖУРНАЛ УСПЕВАЕМОСТИ И ПРОХОЖДЕНИЯ ЛЕКЦИЙ</h3>
    <h5 class="mb-2">Дисциплина: «@(Model.Disciplines.FirstOrDefault(d => d.Id == Model.SelectedDisciplineId)?.Title ?? "Все дисциплины")»</h5>
    <div class="small">
        <span>Преподаватель: <strong>Парван Е.Н.</strong></span> | 
        <span>Дата формирования: <strong>@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</strong></span>
        @if (Model.SelectedGroupId.HasValue)
        {
            <span> | Группа: <strong>@(Model.Groups.FirstOrDefault(g => g.Id == Model.SelectedGroupId)?.Name)</strong></span>
        }
    </div>
    <hr />
</div>

<div class="btn-print-hide mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Teacher" asp-action="Index">Панель преподавателя</a></li>
            <li class="breadcrumb-item active" aria-current="page">Электронный журнал</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h2 class="fw-bold text-dark mb-1">
                        <i class="bi bi-journal-bookmark-fill text-primary me-2"></i>Электронный академический журнал
                    </h2>
                    <p class="text-muted mb-0">Матрица прохождения лекций, результаты тестов, 5-балльные оценки и статистика попыток</p>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-dark fw-bold" onclick="window.print()">
                        <i class="bi bi-printer-fill me-1"></i>Распечатать журнал
                    </button>
                    <a asp-controller="Teacher" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>К панели управления
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="card shadow-sm border-0 rounded-3 mb-4 filter-card">
        <div class="card-body p-3">
            <form method="get" asp-action="Journal" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold small text-muted mb-1"><i class="bi bi-book me-1"></i>Дисциплина</label>
                    <select name="disciplineId" class="form-select" onchange="this.form.submit()">
                        @foreach (var d in Model.Disciplines)
                        {
                            <option value="@d.Id" selected="@(d.Id == Model.SelectedDisciplineId)">@d.Title</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold small text-muted mb-1"><i class="bi bi-people me-1"></i>Учебная группа</label>
                    <select name="groupId" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Все группы --</option>
                        @foreach (var g in Model.Groups)
                        {
                            <option value="@g.Id" selected="@(g.Id == Model.SelectedGroupId)">@g.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100 fw-bold">
                        <i class="bi bi-filter me-1"></i>Применить фильтр
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Stats Bar -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3 text-center">
            <span class="text-muted small">Всего студентов</span>
            <div class="fs-3 fw-bold text-primary">@Model.Stats.TotalStudentsCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3 text-center">
            <span class="text-muted small">Лекций в дисциплине</span>
            <div class="fs-3 fw-bold text-dark">@Model.Stats.TotalLecturesCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3 text-center">
            <span class="text-muted small">Сдано контрольных тестов</span>
            <div class="fs-3 fw-bold text-success">@Model.Stats.TotalPassedAttempts</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3 text-center">
            <span class="text-muted small">Общая успеваемость</span>
            <div class="fs-3 fw-bold text-warning">@Model.Stats.AveragePassRate%</div>
        </div>
    </div>
</div>

<!-- SECTION 1: Matrix View -->
<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>Матрица прохождения лекций по студентам
        </h5>
        <span class="badge bg-light text-muted border btn-print-hide">Зелёный = сдан тест; Жёлтый = в процессе; Серый = закрыто</span>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle mb-0 text-center">
            <thead class="table-light align-middle">
                <tr>
                    <th style="width: 40px;">№</th>
                    <th class="text-start" style="min-width: 200px;">ФИО студента</th>
                    <th style="min-width: 90px;">Группа</th>
                    @foreach (var lec in Model.DisciplineLectures)
                    {
                        <th style="min-width: 120px;" title="@lec.Title">
                            <div>Лекция @lec.OrderIndex</div>
                            <small class="text-muted fw-normal d-block text-truncate" style="max-width: 120px;">@lec.Title</small>
                            <a asp-action="LectureRoster" asp-route-lectureId="@lec.Id" class="btn btn-link btn-sm p-0 text-decoration-none btn-print-hide" title="Открыть ведомость этой лекции">
                                <i class="bi bi-box-arrow-up-right small"></i> ведомость
                            </a>
                        </th>
                    }
                    <th style="min-width: 90px;">Освоено</th>
                    <th style="min-width: 90px;">Ср. балл</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.MatrixRows.Any())
                {
                    <tr>
                        <td colspan="@(Model.DisciplineLectures.Count + 5)" class="py-4 text-muted">
                            Студенты не найдены по выбранным параметрам фильтра.
                        </td>
                    </tr>
                }
                else
                {
                    int sIndex = 1;
                    foreach (var row in Model.MatrixRows)
                    {
                        <tr>
                            <td>@(sIndex++)</td>
                            <td class="text-start fw-bold text-dark">
                                <a asp-action="StudentDetails" asp-route-id="@row.StudentId" class="text-decoration-none text-dark">
                                    @row.FullName
                                </a>
                            </td>
                            <td><span class="badge bg-light text-dark border">@row.GroupName</span></td>

                            @foreach (var lec in Model.DisciplineLectures)
                            {
                                row.LectureCells.TryGetValue(lec.Id, out var cell);
                                if (cell == null)
                                {
                                    <td class="text-muted bg-light">—</td>
                                }
                                else if (cell.IsCompleted)
                                {
                                    <td class="table-success" title="Освоено. Лучший балл: @(cell.ScorePercent)% | Попыток: @cell.AttemptsCount">
                                        <div class="fw-bold text-success"><i class="bi bi-check-circle-fill"></i> @(cell.ScorePercent)%</div>
                                        <small class="badge bg-success-subtle text-success-emphasis border border-success-subtle py-0">@cell.Grade5Scale</small>
                                        <div class="text-muted" style="font-size: 0.75rem;">поп: @cell.AttemptsCount</div>
                                    </td>
                                }
                                else if (cell.IsUnlocked || cell.IsUnlockedManually)
                                {
                                    <td class="table-warning" title="@(cell.IsUnlockedManually ? "Открыта вручную" : "Доступна для изучения")">
                                        <div class="text-warning-emphasis fw-bold">
                                            <i class="bi bi-clock-history"></i> В работе
                                        </div>
                                        @if (cell.ScorePercent.HasValue)
                                        {
                                            <small class="text-muted">(@cell.ScorePercent% - незачет)</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">тест не сдан</small>
                                        }
                                        <div class="text-muted" style="font-size: 0.75rem;">поп: @cell.AttemptsCount</div>
                                    </td>
                                }
                                else
                                {
                                    <td class="table-secondary text-muted" title="Заблокирована последовательным доступом">
                                        <i class="bi bi-lock-fill"></i>
                                        <div style="font-size: 0.75rem;">Закрыта</div>
                                    </td>
                                }
                            }

                            <td>
                                <span class="badge @(row.ProgressPercent >= 100 ? "bg-success" : (row.ProgressPercent > 0 ? "bg-primary" : "bg-secondary")) fs-6">
                                    @row.CompletedCount / @row.TotalLectures
                                </span>
                                <div class="text-muted small">@row.ProgressPercent%</div>
                            </td>
                            <td>
                                <span class="fw-bold @(row.AverageScorePercent >= 70 ? "text-success" : "text-dark")">
                                    @(row.AverageScorePercent > 0 ? $"{row.AverageScorePercent}%" : "—")
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="page-break"></div>

<!-- SECTION 2: Detailed Registry Log (Ученик - Лекция - Оценка - Дата - Попытки) -->
<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-card-checklist text-primary me-2"></i>Сводный журнал успеваемости и протокол попыток (детализация)
        </h5>
        <span class="badge bg-secondary">Всего записей: @Model.DetailEntries.Count</span>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 40px;">№</th>
                    <th>ФИО студента</th>
                    <th>Группа</th>
                    <th>Лекция</th>
                    <th>Статус доступа</th>
                    <th class="text-center">Балл %</th>
                    <th class="text-center">Оценка (5-балльная)</th>
                    <th class="text-center">Попытки</th>
                    <th>Дата активности</th>
                    <th class="text-center">Итог</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.DetailEntries.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center py-4 text-muted">Записи в журнале отсутствуют.</td>
                    </tr>
                }
                else
                {
                    int rIdx = 1;
                    foreach (var entry in Model.DetailEntries)
                    {
                        <tr>
                            <td>@(rIdx++)</td>
                            <td class="fw-semibold">@entry.StudentFullName</td>
                            <td><span class="badge bg-light text-dark border">@entry.GroupName</span></td>
                            <td>
                                <div>№@entry.LectureOrderIndex. @entry.LectureTitle</div>
                            </td>
                            <td>
                                @if (entry.AccessStatus == "Освоена")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check2"></i> Освоена
                                    </span>
                                }
                                else if (entry.AccessStatus.Contains("вручную"))
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                        <i class="bi bi-unlock"></i> Вручную
                                    </span>
                                }
                                else if (entry.AccessStatus == "В процессе изучения")
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                        <i class="bi bi-play-circle"></i> В процессе
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">
                                        <i class="bi bi-lock"></i> Закрыта
                                    </span>
                                }
                            </td>
                            <td class="text-center fw-bold @(entry.IsPassed ? "text-success" : (entry.ScorePercent.HasValue ? "text-danger" : "text-muted"))">
                                @(entry.ScorePercent.HasValue ? $"{entry.ScorePercent.Value}%" : "—")
                            </td>
                            <td class="text-center">
                                <span class="badge @(entry.IsPassed ? "bg-success" : (entry.ScorePercent.HasValue ? "bg-danger" : "bg-light text-dark border"))">
                                    @entry.Grade5Scale
                                </span>
                            </td>
                            <td class="text-center">
                                @entry.AttemptsCount из @entry.MaxAttempts
                            </td>
                            <td class="small text-muted">
                                @(entry.ActivityDate.HasValue ? entry.ActivityDate.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "—")
                            </td>
                            <td class="text-center">
                                @if (entry.IsPassed)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-lg"></i> Зачтено</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-dash"></i> Не зачтено</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Print Official Signature Block -->
<div class="mt-4 pt-4 border-top" style="display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
        <div>Ответственный преподаватель: <strong>Парван Е.Н.</strong></div>
        <div class="small text-muted">Электронный учебный кабинет дисциплины</div>
    </div>
    <div style="text-align: right;">
        <div>Подпись: ______________________ / Парван Е.Н. /</div>
        <div class="small text-muted">М.П.</div>
    </div>
</div>
