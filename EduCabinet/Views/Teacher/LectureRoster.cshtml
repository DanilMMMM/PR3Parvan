@model EduCabinet.Models.LectureRosterViewModel
@{
    ViewData["Title"] = "Списочный состав: " + Model.Lecture.Title;
}

<style>
    @@media print {
        header, footer, .navbar, .btn-print-hide, .filter-card, .breadcrumb {
            display: none !important;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
        }
        body {
            background-color: #fff !important;
            font-size: 11pt;
            color: #000 !important;
        }
        .container {
            max-width: 100% !important;
            width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .table {
            border-collapse: collapse !important;
            width: 100% !important;
        }
        .table th, .table td {
            border: 1px solid #333 !important;
            padding: 6px 8px !important;
            color: #000 !important;
        }
        .print-only-header {
            display: block !important;
            margin-bottom: 20px;
        }
        .badge {
            border: 1px solid #333 !important;
            color: #000 !important;
            background: transparent !important;
        }
    }
    .print-only-header {
        display: none;
    }
</style>

<!-- Printable Official Header -->
<div class="print-only-header text-center">
    <h3 class="fw-bold mb-1">ВЕДОМОСТЬ ПРОХОЖДЕНИЯ ЛЕКЦИИ И СДАЧИ ТЕСТА</h3>
    <h5 class="mb-1">Дисциплина: «@Model.Discipline.Title»</h5>
    <h6 class="mb-2">Тема / Лекция №@Model.Lecture.OrderIndex: «@Model.Lecture.Title»</h6>
    <div class="small">
        <span>Преподаватель: <strong>Парван Е.Н.</strong></span> | 
        <span>Дата формирования: <strong>@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</strong></span>
        @if (Model.SelectedGroupId.HasValue)
        {
            <span> | Группа: <strong>@(Model.Groups.FirstOrDefault(g => g.Id == Model.SelectedGroupId)?.Name)</strong></span>
        }
    </div>
    <hr />
</div>

<div class="btn-print-hide mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Disciplines" asp-action="Index">Дисциплины</a></li>
            <li class="breadcrumb-item"><a asp-controller="Disciplines" asp-action="Details" asp-route-id="@Model.Discipline.Id">@Model.Discipline.Title</a></li>
            <li class="breadcrumb-item"><a asp-controller="Lectures" asp-action="Details" asp-route-id="@Model.Lecture.Id">Лекция @Model.Lecture.OrderIndex</a></li>
            <li class="breadcrumb-item active" aria-current="page">Списочный состав</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <span class="badge bg-primary mb-2">Ведомость успеваемости по лекции</span>
                    <h3 class="fw-bold text-dark mb-1">
                        <i class="bi bi-people-fill text-primary me-2"></i>Лекция №@Model.Lecture.OrderIndex: @Model.Lecture.Title
                    </h3>
                    <div class="text-muted small">
                        <span>Дисциплина: <strong>@Model.Discipline.Title</strong></span> | 
                        <span>Преподаватель: <strong>Парван Е.Н.</strong></span>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-dark fw-bold" onclick="window.print()">
                        <i class="bi bi-printer-fill me-1"></i>Распечатать ведомость
                    </button>
                    <a asp-controller="Teacher" asp-action="Journal" asp-route-disciplineId="@Model.Discipline.Id" class="btn btn-outline-primary">
                        <i class="bi bi-table me-1"></i>Общий журнал
                    </a>
                    <a asp-controller="Lectures" asp-action="Details" asp-route-id="@Model.Lecture.Id" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>К лекции
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card shadow-sm border-0 rounded-3 mb-4 filter-card">
        <div class="card-body p-3">
            <form method="get" asp-action="LectureRoster" class="row g-3 align-items-end">
                <input type="hidden" name="lectureId" value="@Model.Lecture.Id" />
                <div class="col-md-8">
                    <label class="form-label fw-semibold small text-muted mb-1"><i class="bi bi-people me-1"></i>Фильтр по учебной группе</label>
                    <select name="groupId" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Все учебные группы --</option>
                        @foreach (var g in Model.Groups)
                        {
                            <option value="@g.Id" selected="@(g.Id == Model.SelectedGroupId)">@g.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100 fw-bold">
                        <i class="bi bi-funnel me-1"></i>Показать список
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Summary Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3 text-center">
            <span class="text-muted small">Всего студентов в списке</span>
            <div class="fs-3 fw-bold text-dark">@Model.TotalEnrolled</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3 text-center">
            <span class="text-muted small">Освоили лекцию (зачтено)</span>
            <div class="fs-3 fw-bold text-success">@Model.TotalCompleted</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3 text-center">
            <span class="text-muted small">В процессе изучения</span>
            <div class="fs-3 fw-bold text-warning">@Model.TotalInProgress</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-3 text-center">
            <span class="text-muted small">Процент сдачи (Pass Rate)</span>
            <div class="fs-3 fw-bold text-primary">@Model.PassRatePercent%</div>
        </div>
    </div>
</div>

<!-- Main Table: Roster of Students -->
<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-list-check text-primary me-2"></i>Списочный состав студентов и результаты прохождения
        </h5>
        <span class="badge bg-secondary">Студентов: @Model.StudentRows.Count</span>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light align-middle text-center">
                <tr>
                    <th style="width: 45px;">№ п/п</th>
                    <th class="text-start" style="min-width: 220px;">ФИО студента</th>
                    <th style="min-width: 100px;">Группа</th>
                    <th style="min-width: 170px;">Статус доступа к лекции</th>
                    <th style="min-width: 90px;">Попыток</th>
                    <th style="min-width: 110px;">Лучший балл</th>
                    <th style="min-width: 120px;">Оценка (5-балльная)</th>
                    <th style="min-width: 140px;">Дата сдачи</th>
                    <th style="min-width: 110px;">Отметка о зачёте</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.StudentRows.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            Студенты по выбранным параметрам не найдены.
                        </td>
                    </tr>
                }
                else
                {
                    int index = 1;
                    foreach (var s in Model.StudentRows)
                    {
                        <tr class="@(s.IsCompleted ? "table-success-subtle" : "")">
                            <td class="text-center">@(index++)</td>
                            <td class="fw-bold text-dark">
                                <a asp-controller="Teacher" asp-action="StudentDetails" asp-route-id="@s.StudentId" class="text-decoration-none text-dark">
                                    @s.FullName
                                </a>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@s.GroupName</span>
                            </td>
                            <td>
                                @if (s.IsCompleted)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle-fill me-1"></i>Освоено (Зачтено)
                                    </span>
                                }
                                else if (s.IsUnlockedManually)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                        <i class="bi bi-unlock-fill me-1"></i>Открыто вручную
                                    </span>
                                }
                                else if (s.IsUnlocked)
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                        <i class="bi bi-hourglass-split me-1"></i>Доступно для изучения
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">
                                        <i class="bi bi-lock-fill me-1"></i>Заблокировано
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                @s.AttemptsCount
                            </td>
                            <td class="text-center fw-bold @(s.BestScorePercent >= 70 ? "text-success" : (s.BestScorePercent.HasValue ? "text-danger" : "text-muted"))">
                                @(s.BestScorePercent.HasValue ? $"{s.BestScorePercent}%" : "—")
                            </td>
                            <td class="text-center">
                                <span class="badge @(s.BestScorePercent >= 70 ? "bg-success" : (s.BestScorePercent.HasValue ? "bg-danger" : "bg-light text-dark border"))">
                                    @s.Grade5Scale
                                </span>
                            </td>
                            <td class="text-center small text-muted">
                                @(s.CompletedDate.HasValue ? s.CompletedDate.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "—")
                            </td>
                            <td class="text-center fw-bold">
                                @if (s.IsCompleted)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-lg"></i> Зачтено</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-dash"></i> Не зачтено</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Official Print Signature Footer -->
<div class="mt-4 pt-4 border-top" style="display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
        <div>Преподаватель: <strong>Парван Е.Н.</strong></div>
        <div class="small text-muted">Электронный кабинет преподавателя / Кафедра ИС</div>
    </div>
    <div style="text-align: right;">
        <div>Подпись преподавателя: ______________________ / Парван Е.Н. /</div>
        <div class="small text-muted">М.П.</div>
    </div>
</div>
