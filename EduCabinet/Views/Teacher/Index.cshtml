@model EduCabinet.Models.TeacherDashboardViewModel
@{
    ViewData["Title"] = "Панель преподавателя";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-warning me-2"></i>Панель управления преподавателя</h2>
        <p class="text-muted mb-0">Мониторинг успеваемости, управление учебными материалами и разграничение доступа</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Journal" class="btn btn-warning fw-bold text-dark shadow-sm">
            <i class="bi bi-journal-bookmark me-1"></i>Электронный журнал
        </a>
        <a asp-controller="Disciplines" asp-action="Create" class="btn btn-primary fw-bold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Новая дисциплина
        </a>
        <a asp-action="AuditLogs" class="btn btn-outline-dark">
            <i class="bi bi-journal-text me-1"></i>Журнал аудита
        </a>
    </div>
</div>

<!-- Summary Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-primary text-white">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <div class="small opacity-75">Всего студентов</div>
                    <div class="fs-2 fw-bold">@Model.TotalStudents</div>
                </div>
                <i class="bi bi-people-fill fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-success text-white">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <div class="small opacity-75">Дисциплин</div>
                    <div class="fs-2 fw-bold">@Model.TotalDisciplines</div>
                </div>
                <i class="bi bi-book-half fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-info text-white">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <div class="small opacity-75">Лекций в системе</div>
                    <div class="fs-2 fw-bold">@Model.TotalLectures</div>
                </div>
                <i class="bi bi-journal-text fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-warning text-dark">
            <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-muted">Сдано тестов</div>
                    <div class="fs-2 fw-bold">@Model.TotalAttempts</div>
                </div>
                <i class="bi bi-clipboard2-check fs-1 text-dark opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- Students Progress Table (Section 3.8 of assignment) -->
<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-table text-primary me-2"></i>Успеваемость и прогресс студентов по дисциплинам
        </h5>
        <span class="badge bg-light text-dark border">Группы: @string.Join(", ", Model.Groups.Select(g => g.Name))</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ФИО студента</th>
                    <th>Группа</th>
                    <th>Дисциплина</th>
                    <th>Освоено лекций</th>
                    <th style="min-width: 180px;">Прогресс</th>
                    <th>Средний балл</th>
                    <th>Последняя активность</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.StudentsProgress.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Зарегистрированных студентов пока нет.</td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model.StudentsProgress)
                    {
                        <tr>
                            <td class="fw-bold text-dark">
                                <i class="bi bi-person-fill text-secondary me-1"></i>@row.FullName
                            </td>
                            <td><span class="badge bg-secondary-subtle text-dark border">@row.GroupName</span></td>
                            <td class="small">@row.DisciplineTitle</td>
                            <td>
                                <strong>@row.CompletedLectures</strong> / @row.TotalLectures
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px;">
                                        <div class="progress-bar bg-success" style="width: @row.OverallProgressPercent%"></div>
                                    </div>
                                    <span class="small fw-bold">@row.OverallProgressPercent%</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge @(row.AverageScorePercent >= 70 ? "bg-success" : (row.AverageScorePercent > 0 ? "bg-warning text-dark" : "bg-secondary"))">
                                    @(row.AverageScorePercent > 0 ? $"{row.AverageScorePercent}%" : "—")
                                </span>
                            </td>
                            <td class="small text-muted">
                                @(row.LastActivityAt.HasValue ? row.LastActivityAt.Value.ToString("dd.MM.yyyy HH:mm") : "Нет данных")
                            </td>
                            <td class="text-end">
                                <a asp-action="StudentDetails" asp-route-id="@row.StudentId" class="btn btn-sm btn-outline-primary fw-semibold">
                                    <i class="bi bi-sliders me-1"></i>Управление
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
