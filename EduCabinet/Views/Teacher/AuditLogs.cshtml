@model IEnumerable<EduCabinet.Models.AuditLog>
@{
    ViewData["Title"] = "Журнал аудита действий";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-journal-text text-primary me-2"></i>Журнал аудита событий</h2>
        <p class="text-muted mb-0">Фиксация действий преподавателей, изменений в структуре курсов и ручных разблокировок</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>К панели управления
    </a>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th style="width: 180px;">Дата и время</th>
                    <th style="width: 160px;">Тип действия</th>
                    <th style="width: 200px;">Преподаватель</th>
                    <th>Подробное описание события</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">Событий пока не зарегистрировано.</td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="text-muted small">#@log.Id</td>
                            <td class="small">@log.Timestamp.ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td>
                                @if (log.Action == "ManualUnlock")
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-unlock me-1"></i>Разблокировка</span>
                                }
                                else if (log.Action == "ResetAttempts")
                                {
                                    <span class="badge bg-danger"><i class="bi bi-arrow-counterclockwise me-1"></i>Сброс попыток</span>
                                }
                                else if (log.Action.StartsWith("Create"))
                                {
                                    <span class="badge bg-success"><i class="bi bi-plus me-1"></i>Создание</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">@log.Action</span>
                                }
                            </td>
                            <td>
                                <i class="bi bi-person-fill text-muted me-1"></i>@(log.Teacher?.FullName ?? "Система")
                            </td>
                            <td class="small">@log.Details</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
